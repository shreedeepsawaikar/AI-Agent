# Environment variables & secrets (CRITICAL: Do not remove)
.env
.env.*
!.env.example

# Python
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Local Vector DB & Indexes
.chroma_db/

# RAG uploaded documents (prevent committing personal files)
context/*
!context/.gitkeep

# Temporary research output dumps
research_output.json
research_output.txt

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
